# Server-only carousel credentials. Never prefix these with VITE_.
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_2=
# Optional model override; defaults to gemini-2.5-flash.
GEMINI_MODEL=

# Optional public Web3Forms access key. Without it, contact opens an email draft.
VITE_WEB3FORMS_KEY=
# Optional analytics project key and host.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
